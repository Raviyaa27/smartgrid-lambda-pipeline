          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(smartgrid_speed_records_total{outcome!=\"valid\"}[2m])) / sum(rate(smartgrid_speed_records_total[2m]))",
