    {
      "id": 9,
      "type": "timeseries",
      "title": "Readings per second: produced and processed",
      "description": "Meter simulator output against speed-layer throughput. Apart = backlog.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
