# ═══════════════════════════════════════════════════════════════
#  smartgrid-lambda-pipeline — configuration
#  Copy to `.env` and adjust. `.env` is gitignored.
# ═══════════════════════════════════════════════════════════════

# ── Kafka ──────────────────────────────────────────────────────
# Two addresses: containers reach the broker as `kafka:29092`,
# your laptop reaches the same broker as `localhost:9092`.
KAFKA_BOOTSTRAP_HOST=localhost:9092
KAFKA_BOOTSTRAP_DOCKER=kafka:29092
KAFKA_TOPIC_READINGS=meter.readings.v1
KAFKA_TOPIC_DLQ=meter.readings.dlq.v1

# ── PostgreSQL (serving layer) ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartgrid
POSTGRES_PASSWORD=smartgrid
POSTGRES_SERVING_DB=smartgrid
POSTGRES_AIRFLOW_DB=airflow

# ── MinIO (master dataset / immutable archive) ─────────────────
MINIO_ENDPOINT_HOST=http://localhost:9000
MINIO_ENDPOINT_DOCKER=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_LAKE=lake

# ── Simulated clock ────────────────────────────────────────────
# The brief requires this to be stated explicitly. One simulated
# day is compressed into SIM_DAY_SECONDS of wall-clock time.
SIM_DAY_SECONDS=300
SIM_START_DATE=2026-01-01

# ── Simulation scale ───────────────────────────────────────────
SIM_NUM_HOUSEHOLDS=200
SIM_NUM_ZONES=6
SIM_EMIT_INTERVAL_SECONDS=2

# ── Fault injection ────────────────────────────────────────────
# none | realistic | chaos. `realistic` corrupts ~2.7% of readings
# and takes a few meters offline per simulated day; `chaos` is ~10x.
# The same profile drives the daily batch source: `realistic` makes
# ~10% of drops late, ~5% corrupt and ~2% missing.
SIM_FAULT_PROFILE=realistic

# ── Observability ──────────────────────────────────────────────
# Prometheus scrape port for the meter simulator (0 disables it).
PRODUCER_METRICS_PORT=9101
# ...and for the daily batch source.
BATCH_SOURCE_METRICS_PORT=9102